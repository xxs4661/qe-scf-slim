&CONTROL
  calculation = 'scf',
  prefix      = 'Ni_fcc',
  pseudo_dir = './pseudos',
  outdir      = './qe_tmp',
  disk_io     = 'none',
  wf_collect  = .false.,
/
&SYSTEM
  ibrav=0, nat=4, ntyp=1,
  ecutwfc=60, ecutrho=600,
  input_dft='PBE',
  occupations='smearing', smearing='gaussian', degauss=0.02,
  nspin=2, starting_magnetization(1)=0.30
/
&ELECTRONS
  mixing_beta=0.20, electron_maxstep=120
/
ATOMIC_SPECIES
Ni 58.6934 Ni.pbe-spn-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
  3.524 0.000 0.000
  0.000 3.524 0.000
  0.000 0.000 3.524
ATOMIC_POSITIONS crystal
Ni 0.0000 0.0000 0.0000
Ni 0.5000 0.5000 0.0000
Ni 0.5000 0.0000 0.5000
Ni 0.0000 0.5000 0.5000
K_POINTS automatic
16 16 16  0 0 0