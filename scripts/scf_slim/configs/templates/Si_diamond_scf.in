&CONTROL
  calculation = 'scf',
  prefix      = 'Si_diamond',
  pseudo_dir = './pseudos',
  outdir      = './qe_tmp',
  disk_io     = 'none',
  wf_collect  = .false.,
/
&SYSTEM
  ibrav=0, nat=8, ntyp=1,
  ecutwfc=55, ecutrho=550,
  input_dft='PBE',
  occupations='fixed'
/
&ELECTRONS
  conv_thr=1.0d-8, mixing_beta=0.20, electron_maxstep=120
/
ATOMIC_SPECIES
Si 28.085 Si.pbe-n-rrkjus_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
  5.431020511 0.000000000 0.000000000
  0.000000000 5.431020511 0.000000000
  0.000000000 0.000000000 5.431020511
ATOMIC_POSITIONS crystal
Si 0.0000 0.0000 0.0000
Si 0.0000 0.5000 0.5000
Si 0.5000 0.0000 0.5000
Si 0.5000 0.5000 0.0000
Si 0.2500 0.2500 0.2500
Si 0.2500 0.7500 0.7500
Si 0.7500 0.2500 0.7500
Si 0.7500 0.7500 0.2500
K_POINTS automatic
8 8 8  0 0 0