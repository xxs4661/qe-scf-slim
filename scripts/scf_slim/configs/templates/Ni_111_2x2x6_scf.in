&CONTROL
  calculation = 'scf',
  prefix = 'Ni111',
  pseudo_dir = './pseudos',
  outdir = './work',
  disk_io = 'none',
  verbosity = 'high'
/
&SYSTEM
  ibrav = 0,
  nat = 24, ntyp = 1,
  ecutwfc = 60,
  ecutrho = 480,
  occupations = 'smearing',
  smearing = 'gaussian',
  degauss = 0.020,         ! Bandit 将覆盖
  nspin = 2
/
&ELECTRONS
  diagonalization = 'david',
  mixing_mode = 'local-TF',! slab 推荐
  mixing_beta = 0.180000,  ! Bandit 将覆盖
  mixing_ndim = 8,
  conv_thr = 1.0d-6,       ! runner 将覆盖
  electron_maxstep = 60    ! runner 将覆盖
/
ATOMIC_SPECIES
  Ni 58.6934 Ni.pbe-spn-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
  4.9760  0.0000  0.0000        ! a1 = 2*a/√2,  a≈3.52 Å -> a/√2≈2.488
  2.4880  4.3080  0.0000        ! a2 = (a/√2, √3*a/√2, 0)
  0.0000  0.0000 27.1860        ! a3 = 6*d111 + 15 Å; d111=a/√3≈2.031 Å

ATOMIC_POSITIONS crystal
  ! 2x2平面上的四点 S={(0,0),(1/2,0),(0,1/2),(1/2,1/2)}
  ! 层偏移：A:(0,0), B:(1/3,1/3), C:(2/3,2/3)
  ! 六层 z 分数（含真空居中）：0.276, 0.351, 0.426, 0.501, 0.576, 0.651 （近似）

  ! A1 (z=0.276)
  Ni 0.000000 0.000000 0.276
  Ni 0.500000 0.000000 0.276
  Ni 0.000000 0.500000 0.276
  Ni 0.500000 0.500000 0.276

  ! B1 (z=0.351)
  Ni 0.333333 0.333333 0.351
  Ni 0.833333 0.333333 0.351
  Ni 0.333333 0.833333 0.351
  Ni 0.833333 0.833333 0.351

  ! C1 (z=0.426)
  Ni 0.666667 0.666667 0.426
  Ni 0.166667 0.666667 0.426
  Ni 0.666667 0.166667 0.426
  Ni 0.166667 0.166667 0.426

  ! A2 (z=0.501)
  Ni 0.000000 0.000000 0.501
  Ni 0.500000 0.000000 0.501
  Ni 0.000000 0.500000 0.501
  Ni 0.500000 0.500000 0.501

  ! B2 (z=0.576)
  Ni 0.333333 0.333333 0.576
  Ni 0.833333 0.333333 0.576
  Ni 0.333333 0.833333 0.576
  Ni 0.833333 0.833333 0.576

  ! C2 (z=0.651)
  Ni 0.666667 0.666667 0.651
  Ni 0.166667 0.666667 0.651
  Ni 0.666667 0.166667 0.651
  Ni 0.166667 0.166667 0.651

K_POINTS automatic
  8 8 1  0 0 0

# 可选初猜
# starting_magnetization(Ni) = 0.55
