&CONTROL
  calculation = 'scf'
  prefix = 'Bi2Se3_hexconv_15_SOC'
  outdir = './'
  wf_collect = .false.
  disk_io = 'low'
/
&SYSTEM
  ibrav = 0
  nat = 15
  ntyp = 2
  ecutwfc = 55
  ecutrho = 440
  occupations = 'fixed'
  noncolin = .true.
  lspinorb = .true.
/
&ELECTRONS
  mixing_mode = 'plain'
  mixing_beta = 0.4
  mixing_ndim = 4
  conv_thr = 1.0d-8
  electron_maxstep = 200
  startingwfc = 'atomic'
/
