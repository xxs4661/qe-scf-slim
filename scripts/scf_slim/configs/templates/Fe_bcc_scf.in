&CONTROL
  calculation = 'scf'
  prefix = 'Fe_bcc'
  outdir = './'
  wf_collect = .false.
  disk_io = 'low'
/
&SYSTEM
  ibrav=0, nat=2, ntyp=1,
  ecutwfc=60, ecutrho=600,
  input_dft='PBE',
  occupations='smearing', smearing='gaussian', degauss=0.02,
  nspin=2, starting_magnetization(1)=0.60
/
&ELECTRONS
  mixing_beta=0.20, electron_maxstep=120
/
ATOMIC_SPECIES
Fe 55.845 Fe.pbe-spn-kjpaw_psl.0.2.1.UPF
CELL_PARAMETERS angstrom
  2.866 0.000 0.000
  0.000 2.866 0.000
  0.000 0.000 2.866
ATOMIC_POSITIONS crystal
Fe 0.0000 0.0000 0.0000
Fe 0.5000 0.5000 0.5000
K_POINTS automatic
16 16 16  0 0 0
